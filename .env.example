# Gere um segredo exclusivo com: openssl rand -base64 32
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_BASE64_ALEATORIO_DE_PELO_MENOS_32_BYTES
JWT_TOKEN_VALIDITY=PT2H
ADMIN_USERNAME=SUBSTITUA_POR_UM_USERNAME_ADMIN
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_DE_PELO_MENOS_12_CARACTERES
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Banco local H2 (perfil dev); altere DB_URL/DB_USERNAME/DB_PASSWORD se necessário.
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=sa
DB_PASSWORD=

# Ajustes opcionais do pool PostgreSQL (perfil prod) e do Flyway.
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
FLYWAY_CONNECT_RETRIES=10

# Documentação da API (habilitada por padrão apenas conforme a configuração do perfil).
OPENAPI_ENABLED=false
SWAGGER_UI_ENABLED=false
